<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
  <div class="container-fluid">
    <%= link_to "CitcomApp", root_path, class: "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <!-- Left side -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Complains", complains_path, class: "nav-link" %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "New Complain", new_complain_path, class: "nav-link" %>
          </li>
        <% end %>
        <% if user_signed_in? && current_user&.user_type == 'admin' %>
          <li class="nav-item">
            <%= link_to 'Admin Dashboard', admin_dashboard_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>

      <!-- Search form -->
      <%= form_with url: complains_path, method: :get, local: true, class: "d-flex" do |form| %>
        <%= form.text_field :query, class: "form-control me-2", placeholder: "Search complains..." %>
      <% end %>

      <!-- Right side: Auth links -->
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if user_signed_in? %>
          <li class="nav-item">
            <span class="nav-link text-white">👋 <%= current_user&.first_name.presence || "User" %></span>
          </li>
          <li class="nav-item">
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-link nav-link", form: { class: "d-inline" } %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Signup", new_user_registration_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
